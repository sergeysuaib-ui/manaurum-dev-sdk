# Keep the build context small and, above all, keep credentials out of
# the image. `manaurum app deploy` uploads this directory as the Docker
# build context; anything listed here never reaches the builder.
.env
.env.*
*.pem
*.key

.git/
.gitignore
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

node_modules/
dist/
build/
*.egg-info/
*.tar.gz

# Applied by Core per tenant, never needed inside the image.
# NOTE: on a platform deploy this line changes nothing - the tarball goes
# straight to Docker's build endpoint, which does not apply .dockerignore
# server-side. It is what keeps migrations out of a LOCAL `docker build`.
# The platform copy is excluded by your Dockerfile's COPY list instead.
migrations/

# Tests run on your machine and in CI, never in the runtime image.
tests/
pytest.ini
requirements-dev.txt
