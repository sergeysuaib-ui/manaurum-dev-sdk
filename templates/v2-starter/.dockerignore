# For a LOCAL `docker build`: keeps the context small and credentials out
# of the image. On a platform deploy this file does nothing: the CLI
# uploads the directory minus caches, .venv, .git, node_modules, dist and
# build, and Core's classic builder does not apply .dockerignore. There,
# the Dockerfile's COPY list keeps files out of the image, and nothing
# keeps them out of the stored source - so keep .env* out of this
# directory altogether.
.env
.env.*
*.pem
*.key

.git/
.gitignore
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

node_modules/
dist/
build/
*.egg-info/
*.tar.gz

# Applied by Core per tenant, never needed inside the image.
migrations/

# Tests run on your machine and in CI, never in the runtime image.
tests/
pytest.ini
requirements-dev.txt
